{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Nyaya Nagri design tokens (DTCG). SINGLE SOURCE OF TRUTH, extracted from the Nyaya Nagri app (artifacts/nyaya-nagri/src/index.css :root + recurring app hexes). Light mode is source-faithful; DARK MODE IS DERIVED (the app ships light-only) — anchored on the app's own navy chrome (#16254C HUD/panels). Edit values here only; never hand-edit generated files.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#fcfbf8", "$description": "Warm cream page (app hsl(45 40% 98%))." },
      "foreground": { "$value": "#1f2c47", "$description": "Deep navy text (app hsl(220 40% 20%))." },
      "border": { "$value": "#e0ddd1" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#1f2c47" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#1f2c47" },
      "primary": {
        "$value": "#f9931f",
        "$description": "Brand orange (app hsl(32 95% 55%)) — CTAs, focus, achievement. App pairs it with white text + drop shadow."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#0db9f2", "$description": "Sky blue (app hsl(195 90% 50%))." },
      "secondaryForeground": { "$value": "#ffffff" },
      "muted": { "$value": "#ebe8e0" },
      "mutedForeground": { "$value": "#525f7a" },
      "accent": { "$value": "#2eb85c", "$description": "Success green (app hsl(140 60% 45%))." },
      "accentForeground": { "$value": "#ffffff" },
      "destructive": { "$value": "#ec1337", "$description": "App hsl(350 85% 50%)." },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#e0ddd1" },
      "ring": { "$value": "#f9931f" },
      "chart1": { "$value": "#f9931f" },
      "chart2": { "$value": "#0db9f2" },
      "chart3": { "$value": "#2eb85c" },
      "chart4": { "$value": "#8b5cf6", "$description": "Zone purple (map nodes)." },
      "chart5": { "$value": "#c9a227", "$description": "Certificate gold." },
      "sidebar": { "$value": "#16254c", "$description": "Navy chrome (app HUD nav #16254c)." },
      "sidebarForeground": { "$value": "#f2efe4" },
      "sidebarBorder": { "$value": "#0f1b3a" },
      "sidebarPrimary": { "$value": "#f9931f" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#1d3f8c", "$description": "App hover navy #1d3f8c." },
      "sidebarAccentForeground": { "$value": "#ffffff" },
      "sidebarRing": { "$value": "#f9931f" }
    },
    "dark": {
      "background": { "$value": "#0e1a33", "$description": "DERIVED: deep navy night (app ships light-only)." },
      "foreground": { "$value": "#f2efe4" },
      "border": { "$value": "#263a66" },
      "card": { "$value": "#16254c", "$description": "App navy chrome as dark surface." },
      "cardForeground": { "$value": "#f2efe4" },
      "popover": { "$value": "#1b2e5c" },
      "popoverForeground": { "$value": "#f2efe4" },
      "primary": { "$value": "#f9931f" },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#0db9f2" },
      "secondaryForeground": { "$value": "#ffffff" },
      "muted": { "$value": "#1c2c52" },
      "mutedForeground": { "$value": "#a8b4d2" },
      "accent": { "$value": "#2eb85c" },
      "accentForeground": { "$value": "#ffffff" },
      "destructive": { "$value": "#f43f5e" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#263a66" },
      "ring": { "$value": "#f9931f" },
      "chart1": { "$value": "#f9a03f" },
      "chart2": { "$value": "#35c3f5" },
      "chart3": { "$value": "#3bc96b" },
      "chart4": { "$value": "#a78bfa" },
      "chart5": { "$value": "#e4b04a" },
      "sidebar": { "$value": "#0b1730" },
      "sidebarForeground": { "$value": "#e9edf8" },
      "sidebarBorder": { "$value": "#1a2a50" },
      "sidebarPrimary": { "$value": "#f9931f" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#1d3f8c" },
      "sidebarAccentForeground": { "$value": "#ffffff" },
      "sidebarRing": { "$value": "#f9931f" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Nunito", "Noto Sans Devanagari", "Noto Sans Gujarati", "sans-serif"],
        "$description": "Body/UI. Noto fallbacks carry Devanagari (Hindi) and Gujarati glyphs, as in the app. Display face Fredoka is wired as --font-display via scripts/theme-template.css (DTCG schema has no display slot)."
      },
      "serif": {
        "$value": ["Playfair Display", "Noto Serif Devanagari", "serif"],
        "$description": "Formal/certificate face (app CertificateDoc)."
      },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1rem",
      "$description": "App --radius: 1rem — big, friendly corners; sm/md/lg/xl derive from this."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem" }
  }
}
